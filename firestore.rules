rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check / connection test
    match /test/{docId} {
      allow read: if true;
    }

    // Products catalog: read by all users across all devices, write by store admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: create on checkout, read by customers tracking or admin managing
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Store global settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
